APP_ENV=development
GIN_MODE=debug

POSTGRES_DB=markmind
POSTGRES_USER=markmind
POSTGRES_PASSWORD=markmind
DATABASE_URL=postgres://markmind:markmind@postgres:5432/markmind?sslmode=disable

REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

JWT_SECRET=markmind-local-jwt-secret-change-me
FRONTEND_ORIGIN=http://localhost:58000
