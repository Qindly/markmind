ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
REFRESH_COOKIE_NAME=markmind_refresh_token
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_HTTP_ONLY=true
COOKIE_SAME_SITE=Lax

AUTH_RATE_LIMIT_WINDOW=1m
AUTH_RATE_LIMIT_MAX_REQUESTS=10
