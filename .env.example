# MarkMind 本地开发环境示例配置
# 可复制为根目录 .env，供 Docker Compose 与本地开发环境加载
APP_ENV=development
GIN_MODE=debug

POSTGRES_DB=markmind
POSTGRES_USER=markmind
POSTGRES_PASSWORD=markmind
DATABASE_URL=postgres://markmind:markmind@postgres:5432/markmind?sslmode=disable

REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

JWT_SECRET=markmind-local-jwt-secret-change-me
AI_PROVIDER_ENCRYPTION_SECRET=markmind-local-ai-secret-change-me
AI_REQUEST_TIMEOUT=60s
AI_PROVIDER_DEBUG=false
FRONTEND_ORIGIN=http://localhost:58000
TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
REFRESH_COOKIE_NAME=markmind_refresh_token
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_HTTP_ONLY=true
COOKIE_SAME_SITE=Lax

AUTH_RATE_LIMIT_WINDOW=1m
AUTH_RATE_LIMIT_MAX_REQUESTS=10

UPLOAD_ROOT_DIR=/app/data/uploads
UPLOAD_PUBLIC_BASE_PATH=/uploads
